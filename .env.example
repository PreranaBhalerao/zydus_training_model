# Invoice Extraction API environment

# Server
HOST=0.0.0.0
PORT=8000

# Upload limit (megabytes)
MAX_UPLOAD_MB=20

# Model (optional overrides; defaults match validation.py)
# BASE_MODEL=unsloth/Qwen2.5-1.5B-Instruct
# MAX_SEQ=8192

# Required at runtime (not env vars — place files on disk):
#   invoice_lora_v3/adapter_model.safetensors
#   invoice_lora/adapter_model.safetensors
#
# Start (from repo root, with CUDA GPU):
#   uvicorn app.main:app --host 0.0.0.0 --port 8000
#
# Extract:
#   curl -X POST http://localhost:8000/v1/invoice/extract \
#     -F "file=@/path/to/invoice.pdf"
